# HPL Auction System - Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hpl_auction
DB_USER=postgres
DB_PASSWORD=postgres

# Application Configuration
APP_PORT=8501
APP_HOST=localhost

# Development/Production Mode
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# Auction Configuration
TEAM_BUDGET=10000000
REGULAR_PLAYER_MIN_PRICE=200000
MARQUEE_PLAYER_MIN_PRICE=1000000
CAPTAIN_PLAYER_PRICE=0
AUCTION_PRICE_STEP=25000
DEFAULT_PLAYER_BASE_PRICE=200000
PLAYER_BASE_PRICE_STEP=100000
MAX_PLAYERS_PER_TEAM=9
REGULAR_PLAYERS_NEEDED=8

# Optional: Custom database connection URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hpl_auction